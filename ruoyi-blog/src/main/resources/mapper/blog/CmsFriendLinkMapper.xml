<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.blog.mapper.CmsFriendLinkMapper">

    <resultMap type="CmsFriendLink" id="CmsFriendLinkResult">
        <id     property="linkId"      column="link_id" />
        <result property="nickname"    column="nickname" />
        <result property="description" column="description" />
        <result property="siteUrl"     column="site_url" />
        <result property="sort"        column="sort" />
        <result property="status"      column="status" />
        <result property="delFlag"     column="del_flag" />
        <result property="createBy"    column="create_by" />
        <result property="createTime"  column="create_time" />
        <result property="updateBy"    column="update_by" />
        <result property="updateTime"  column="update_time" />
        <result property="remark"      column="remark" />
    </resultMap>

    <sql id="selectVo">
        select link_id, nickname, description, site_url, sort, status, del_flag,
               create_by, create_time, update_by, update_time, remark
        from cms_friend_link
    </sql>

    <select id="selectFriendLinkById" parameterType="Long" resultMap="CmsFriendLinkResult">
        <include refid="selectVo"/>
        where link_id = #{linkId} and del_flag = '0'
    </select>

    <select id="selectFriendLinkList" parameterType="CmsFriendLink" resultMap="CmsFriendLinkResult">
        <include refid="selectVo"/>
        <where>
            del_flag = '0'
            <if test="nickname != null and nickname != ''">and nickname like concat('%', #{nickname}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="siteUrl != null and siteUrl != ''">and site_url like concat('%', #{siteUrl}, '%')</if>
        </where>
        order by sort asc, link_id asc
    </select>

    <select id="checkSiteUrlUnique" resultMap="CmsFriendLinkResult">
        <include refid="selectVo"/>
        where site_url = #{siteUrl} and del_flag = '0'
        <if test="linkId != null">and link_id &lt;&gt; #{linkId}</if>
        limit 1
    </select>

    <insert id="insertFriendLink" parameterType="CmsFriendLink" useGeneratedKeys="true" keyProperty="linkId">
        insert into cms_friend_link (
            nickname, description, site_url, sort, status, del_flag, create_by, create_time, remark
        ) values (
            #{nickname}, #{description}, #{siteUrl}, #{sort}, #{status}, '0', #{createBy}, sysdate(), #{remark}
        )
    </insert>

    <update id="updateFriendLink" parameterType="CmsFriendLink">
        update cms_friend_link
        <set>
            <if test="nickname != null and nickname != ''">nickname = #{nickname},</if>
            description = #{description},
            <if test="siteUrl != null and siteUrl != ''">site_url = #{siteUrl},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where link_id = #{linkId}
    </update>

    <update id="deleteFriendLinkByIds">
        update cms_friend_link set del_flag = '2' where link_id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>
