<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.blog.mapper.CmsCategoryMapper">

    <resultMap type="CmsCategory" id="CmsCategoryResult">
        <id     property="categoryId"  column="category_id" />
        <result property="parentId"    column="parent_id" />
        <result property="name"        column="name" />
        <result property="slug"        column="slug" />
        <result property="sort"        column="sort" />
        <result property="status"      column="status" />
        <result property="delFlag"     column="del_flag" />
        <result property="createBy"    column="create_by" />
        <result property="createTime"  column="create_time" />
        <result property="updateBy"    column="update_by" />
        <result property="updateTime"  column="update_time" />
        <result property="remark"      column="remark" />
    </resultMap>

    <sql id="selectVo">
        select category_id, parent_id, name, slug, sort, status, del_flag,
               create_by, create_time, update_by, update_time, remark
        from cms_category
    </sql>

    <select id="selectCategoryById" parameterType="Long" resultMap="CmsCategoryResult">
        <include refid="selectVo"/>
        where category_id = #{categoryId} and del_flag = '0'
    </select>

    <select id="selectCategoryList" parameterType="CmsCategory" resultMap="CmsCategoryResult">
        <include refid="selectVo"/>
        <where>
            del_flag = '0'
            <if test="name != null and name != ''">and name like concat('%', #{name}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="slug != null and slug != ''">and slug = #{slug}</if>
        </where>
        order by sort asc, category_id asc
    </select>

    <select id="checkSlugUnique" resultMap="CmsCategoryResult">
        <include refid="selectVo"/>
        where slug = #{slug} and del_flag = '0'
        <if test="categoryId != null">and category_id &lt;&gt; #{categoryId}</if>
        limit 1
    </select>

    <select id="countArticleByCategoryId" parameterType="Long" resultType="int">
        select count(1) from cms_article where category_id = #{categoryId} and del_flag = '0'
    </select>

    <insert id="insertCategory" parameterType="CmsCategory" useGeneratedKeys="true" keyProperty="categoryId">
        insert into cms_category (
            parent_id, name, slug, sort, status, del_flag, create_by, create_time, remark
        ) values (
            #{parentId}, #{name}, #{slug}, #{sort}, #{status}, '0', #{createBy}, sysdate(), #{remark}
        )
    </insert>

    <update id="updateCategory" parameterType="CmsCategory">
        update cms_category
        <set>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            slug = #{slug},
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where category_id = #{categoryId}
    </update>

    <update id="deleteCategoryByIds">
        update cms_category set del_flag = '2' where category_id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>
